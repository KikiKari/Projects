proc write_css_file {filename} {
    set fd [open $filename w]
    
    puts $fd ":root \{"
    puts $fd "  color-scheme: light;"
    puts $fd "  --ink: #1b1c1f;"
    puts $fd "  --muted: #6c6e75;"
    puts $fd "  --faint: #9a9ca3;"
    puts $fd "  --card: #fff;"
    puts $fd "  --line: #e9eaee;"
    puts $fd "  --accent: #5b5bd6;"
    puts $fd "  --accent2: #7c5cff;"
    puts $fd "  --ok: #22a06b;"
    puts $fd "  --err: #e0533d;"
    puts $fd "  --radius: 16px;"
    puts $fd "  --shadow: 0 1px 2px rgba(20, 20, 40, 0.04), 0 6px 20px rgba(20, 20, 40, 0.06);"
    puts $fd "\}"
    puts $fd ""
    puts $fd "* \{"
    puts $fd "  box-sizing: border-box;"
    puts $fd "\}"
    puts $fd ""
    puts $fd "body \{"
    puts $fd "  margin: 0;"
    puts $fd "  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;"
    puts $fd "  color: var(--ink);"
    puts $fd "  min-height: 100vh;"
    puts $fd "  background: radial-gradient(1100px 560px at 100% -10%, #e8ecff 0%, rgba(232, 236, 255, 0) 55%),"
    puts $fd "    linear-gradient(180deg, #eef1f6, #f7f7f8 42%);"
    puts $fd "  background-attachment: fixed;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".wrap \{"
    puts $fd "  max-width: 820px;"
    puts $fd "  margin: 0 auto;"
    puts $fd "  padding: 24px 18px 70px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".brand \{"
    puts $fd "  display: flex;"
    puts $fd "  align-items: center;"
    puts $fd "  gap: 12px;"
    puts $fd "  margin-bottom: 4px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".mark \{"
    puts $fd "  width: 32px;"
    puts $fd "  height: 32px;"
    puts $fd "  border-radius: 9px;"
    puts $fd "  background: linear-gradient(135deg, var(--accent), var(--accent2));"
    puts $fd "  box-shadow: 0 4px 12px rgba(91, 91, 214, 0.35);"
    puts $fd "  position: relative;"
    puts $fd "  flex: 0 0 auto;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".mark:after \{"
    puts $fd "  content: \"\";"
    puts $fd "  position: absolute;"
    puts $fd "  inset: 8px;"
    puts $fd "  border-radius: 4px;"
    puts $fd "  border: 2px solid rgba(255, 255, 255, 0.92);"
    puts $fd "\}"
    puts $fd ""
    puts $fd "h1 \{"
    puts $fd "  font-size: 21px;"
    puts $fd "  margin: 0;"
    puts $fd "  font-weight: 700;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".sub \{"
    puts $fd "  color: var(--muted);"
    puts $fd "  font-size: 13px;"
    puts $fd "  margin: 2px 0 16px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".card \{"
    puts $fd "  background: var(--card);"
    puts $fd "  border: 1px solid var(--line);"
    puts $fd "  border-radius: var(--radius);"
    puts $fd "  box-shadow: var(--shadow);"
    puts $fd "  padding: 16px;"
    puts $fd "  margin-bottom: 14px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".card h2 \{"
    puts $fd "  font-size: 14px;"
    puts $fd "  margin: 0 0 10px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd "label.lab \{"
    puts $fd "  display: block;"
    puts $fd "  font-size: 12px;"
    puts $fd "  font-weight: 600;"
    puts $fd "  color: var(--muted);"
    puts $fd "  margin: 8px 0 3px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd "input,"
    puts $fd "textarea \{"
    puts $fd "  width: 100%;"
    puts $fd "  font-size: 13px;"
    puts $fd "  padding: 8px 10px;"
    puts $fd "  border: 1px solid var(--line);"
    puts $fd "  border-radius: 9px;"
    puts $fd "  font-family: ui-monospace, Menlo, Consolas, monospace;"
    puts $fd "  background: #fff;"
    puts $fd "\}"
    puts $fd ""
    puts $fd "textarea \{"
    puts $fd "  min-height: 90px;"
    puts $fd "  white-space: pre;"
    puts $fd "  overflow: auto;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".row \{"
    puts $fd "  display: flex;"
    puts $fd "  gap: 8px;"
    puts $fd "  flex-wrap: wrap;"
    puts $fd "  align-items: center;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".btn \{"
    puts $fd "  font-size: 13px;"
    puts $fd "  font-weight: 600;"
    puts $fd "  padding: 8px 14px;"
    puts $fd "  border: 1px solid var(--line);"
    puts $fd "  border-radius: 10px;"
    puts $fd "  background: #fff;"
    puts $fd "  cursor: pointer;"
    puts $fd "  box-shadow: var(--shadow);"
    puts $fd "  transition: transform 0.1s;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".btn:hover \{"
    puts $fd "  transform: translateY(-1px);"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".btn.primary \{"
    puts $fd "  background: linear-gradient(135deg, var(--accent), var(--accent2));"
    puts $fd "  color: #fff;"
    puts $fd "  border-color: transparent;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".btn.sm \{"
    puts $fd "  padding: 5px 9px;"
    puts $fd "  font-size: 12px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".msg \{"
    puts $fd "  font-size: 12px;"
    puts $fd "  margin-left: 6px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".msg.ok \{"
    puts $fd "  color: var(--ok);"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".msg.err \{"
    puts $fd "  color: var(--err);"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".prov \{"
    puts $fd "  border: 1px solid var(--line);"
    puts $fd "  border-radius: 12px;"
    puts $fd "  padding: 10px 12px;"
    puts $fd "  margin-bottom: 10px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".prov h3 \{"
    puts $fd "  margin: 0 0 6px;"
    puts $fd "  font-size: 13.5px;"
    puts $fd "  display: flex;"
    puts $fd "  align-items: center;"
    puts $fd "  gap: 8px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".kv \{"
    puts $fd "  display: grid;"
    puts $fd "  grid-template-columns: 180px 1fr auto;"
    puts $fd "  gap: 6px;"
    puts $fd "  margin: 4px 0;"
    puts $fd "  align-items: center;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".kv input \{"
    puts $fd "  font-size: 12px;"
    puts $fd "  padding: 5px 7px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".kv .k \{"
    puts $fd "  color: var(--muted);"
    puts $fd "  font-weight: 600;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".muted \{"
    puts $fd "  color: var(--faint);"
    puts $fd "  font-size: 13px;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".hide \{"
    puts $fd "  display: none;"
    puts $fd "\}"
    puts $fd ""
    puts $fd ".foot \{"
    puts $fd "  color: var(--faint);"
    puts $fd "  font-size: 11.5px;"
    puts $fd "  text-align: center;"
    puts $fd "  margin-top: 18px;"
    puts $fd "  line-height: 1.5;"
    puts $fd "\}"
    puts $fd ""
    puts $fd "a \{"
    puts $fd "  color: var(--accent);"
    puts $fd "\}"
    
    close $fd
}

# Hauptprogramm
if {$argc != 1} {
    puts stderr "Verwendung: [info script] <ausgabedatei>"
    exit 1
}

set output_file [lindex $argv 0]
write_css_file $output_file
