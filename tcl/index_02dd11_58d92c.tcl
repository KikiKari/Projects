# index_02dd11.tcl - Portierung von index_02dd11.css nach Tcl 8.6
# Erzeugt das CSS-Dokument dynamisch und schreibt es in eine Datei.

proc write_css_to_file {filename} {
    set css [generate_css]
    set fh [open $filename w]
    puts $fh $css
    close $fh
}

proc generate_css {} {
