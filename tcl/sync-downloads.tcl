#!/usr/bin/env tclsh
# sync-downloads.py — portiert nach tcl
# Quelle: python, Projects@TikTok-Live-Companion:site/scripts/sync-downloads.py
# auch in: Projects@vercel/install-and-configure-vercel-s-8vf8rt:site/scripts/sync-downloads.py
# Erzeugt: 2026-10-22 durch ABSTRACTIONS_MANAGER.py

# Install a prepared artifact set and derive the site's checksums from its bytes.

package require sha256
package require zipfile

proc read_json {filename} {
    set fh [open $filename r]
    set data [read $fh]
    close $fh
    return [::json::json2dict $data]
}

proc write_json {filename data} {
    set fh [open $filename w]
    puts $fh [::json::dict2json $data]
    close $fh
}

proc get_file_hash {filename} {
    set fh [open $filename rb]
    set hash [::sha2::sha256 -channel $fh]
    close $fh
    return $hash
}

# Parse command line arguments
if {$argc != 2 || [lindex $argv 0] ne "--from-dir"} {
    puts stderr "Usage: sync-downloads.tcl --from-dir <directory>"
    exit 1
}
set from_dir [lindex $argv 1]

# Get site directory (parent of script directory)
set script_dir [file normalize [file dirname $argv0]]
set site [file dirname $script_dir]

# Read version from manifest
set manifest_path [file join [file dirname $site] plugin-source browser-extension manifest.json]
set manifest [read_json $manifest_path]
set version [dict get $manifest version]

# Define artifact names
set kinds_and_suffixes {
    {"extension" ""}
    {"plugin" ""}
    {"service" ""}
    {"android" "-source"}
    {"ios" "-source"}
}
set names {}
foreach {kind suffix} $kinds_and_suffixes {
    lappend names "tiktok-live-companion-${kind}-${version}${suffix}.zip"
}

set apk_name "tiktok-live-companion-android-${version}.apk"
if {[file exists [file join $from_dir $apk_name]]} {
    lappend names $apk_name
}

# Validate ZIP files
foreach name $names {
    set src [file join $from_dir $name]
    if {![file exists $src]} {
        puts stderr "Missing file: $src"
        exit 1
    }
    
    # Test ZIP integrity
    set zf [::zipfile::open $src]
    if {[::zipfile::test $zf] ne ""} {
        puts stderr "Corrupt ZIP: $name"
        ::zipfile::close $zf
        exit 1
    }
    
    # Check manifest version for extension files
    if {[string match "*extension*" $name]} {
        set manifest_data [::zipfile::getfile $zf "manifest.json"]
        set zip_manifest [::json::json2dict $manifest_data]
        if {[dict get $zip_manifest version] ne $version} {
            puts stderr "Manifest version mismatch"
            ::zipfile::close $zf
            exit 1
        }
    }
    ::zipfile::close $zf
}

# Copy files to destination
set dest_dir [file join $site public downloads]
file mkdir $dest_dir

foreach name $names {
    set src [file join $from_dir $name]
    set dest [file join $dest_dir $name]
    file copy -force $src $dest
}

# Generate hashes
set hashes ""
foreach name $names {
    set full_path [file join $dest_dir $name]
    set hash [get_file_hash $full_path]
    append hashes "${hash}  ${name}\n"
}

# Write SHA256 checksum file
set checksum_file [file join $dest_dir "tiktok-live-companion-${version}-SHA256.txt"]
set fh [open $checksum_file w]
puts -nonewline $fh $hashes
close $fh

# Write TypeScript checksums file
set ts_file [file join $site src download-checksums.ts]
set fh [open $ts_file w]
puts $fh "// Generated by site/scripts/sync-downloads.tcl; do not edit by hand."
puts $fh "export const downloadChecksums = [json::dict2json $hashes];"
close $fh

# Print hashes
puts -nonewline $hashes
