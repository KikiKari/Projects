# Tcl-Programm zur Erzeugung der globals.css
# Portierung von CSS zu Tcl 8.6

proc writeGlobalsCss {filename} {
    set fp [open $filename w]
    
    puts $fp "@import \"tailwindcss\";"
    puts $fp ""
    puts $fp ":root {"
    puts $fp "  --bg: #faf8f4;"
    puts $fp "  --surface: #ffffff;"
    puts $fp "  --surface-2: #f1eee7;"
    puts $fp "  --ink: #1b1a17;"
    puts $fp "  --ink-2: #3c3a34;"
    puts $fp "  --muted: #6e6a61;"
    puts $fp "  --line: #e5e1d8;"
    puts $fp "  --line-strong: #d4cfc3;"
    puts $fp "  --accent: #a8542f;"
    puts $fp "  --accent-press: #8e4526;"
    puts $fp "  --accent-tint: #f1e5dd;"
    puts $fp "  --on-accent: #ffffff;"
    puts $fp "  --accent-2: #2e7d7b;"
    puts $fp "  --accent-2-press: #225e5b;"
    puts $fp "  --accent-3: #c77d2e;"
    puts $fp "  --footer-bg: #191815;"
    puts $fp "  --footer-fg: #efeae0;"
    puts $fp "  --footer-muted: #9a958a;"
    puts $fp "  --success: #2e7d5b;"
    puts $fp "  --danger: #9e3f32;"
    puts $fp "  --font-display: \"Iowan Old Style\", \"Palatino Linotype\", Georgia, \"Times New Roman\", serif;"
    puts $fp "  --font-sans: \"Segoe UI\", Inter, system-ui, -apple-system, sans-serif;"
    puts $fp "  --font-mono: \"Cascadia Code\", \"SFMono-Regular\", Consolas, ui-monospace, monospace;"
    puts $fp "  --space-1: 0.25rem;"
    puts $fp "  --space-2: 0.5rem;"
    puts $fp "  --space-3: 0.75rem;"
    puts $fp "  --space-4: 1rem;"
    puts $fp "  --space-5: 1.25rem;"
    puts $fp "  --space-6: 1.5rem;"
    puts $fp "  --space-8: 2rem;"
    puts $fp "  --space-10: 2.5rem;"
    puts $fp "  --space-12: 3rem;"
    puts $fp "  --space-16: 4rem;"
    puts $fp "  --space-20: 5rem;"
    puts $fp "  --space-24: 6rem;"
    puts $fp "  --space-30: 7.5rem;"
    puts $fp "  --radius-sm: 0.375rem;"
    puts $fp "  --radius-md: 0.625rem;"
    puts $fp "  --radius-lg: 1.125rem;"
    puts $fp "  --radius-pill: 999px;"
    puts $fp "  --shadow-sm: 0 1px 2px rgb(27 26 23 / 6%);"
    puts $fp "  --shadow-md: 0 10px 30px -16px rgb(27 26 23 / 22%);"
    puts $fp "  --shadow-lg: 0 34px 70px -34px rgb(27 26 23 / 32%);"
    puts $fp "  --container: 75rem;"
    puts $fp "  --motion-fast: 180ms;"
    puts $fp "  --motion-base: 350ms;"
    puts $fp "  --motion-slow: 800ms;"
    puts $fp "  --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);"
    puts $fp "}"
    puts $fp ""
    puts $fp "@theme inline {"
    puts $fp "  --color-bg: var(--bg);"
    puts $fp "  --color-surface: var(--surface);"
    puts $fp "  --color-surface-2: var(--surface-2);"
    puts $fp "  --color-ink: var(--ink);"
    puts $fp "  --color-ink-2: var(--ink-2);"
    puts $fp "  --color-muted: var(--muted);"
    puts $fp "  --color-line: var(--line);"
    puts $fp "  --color-line-strong: var(--line-strong);"
    puts $fp "  --color-accent: var(--accent);"
    puts $fp "  --color-accent-2: var(--accent-2);"
    puts $fp "  --color-accent-3: var(--accent-3);"
    puts $fp "  --font-display: var(--font-display);"
    puts $fp "  --font-sans: var(--font-sans);"
    puts $fp "  --font-mono: var(--font-mono);"
    puts $fp "}"
    puts $fp ""
    puts $fp "* { box-sizing: border-box; }"
    puts $fp "html { scroll-behavior: smooth; }"
    puts $fp "body {"
    puts $fp "  margin: 0;"
    puts $fp "  background: var(--bg);"
    puts $fp "  color: var(--ink);"
    puts $fp "  font-family: var(--font-sans);"
    puts $fp "  line-height: 1.5;"
    puts $fp "  -webkit-font-smoothing: antialiased;"
    puts $fp "}"
    puts $fp "a { color: inherit; }"
    puts $fp "button, input, textarea { font: inherit; }"
    puts $fp "::selection { background: var(--accent-tint); color: var(--ink); }"
    puts $fp ""
    puts $fp ".display {"
    puts $fp "  font-family: var(--font-display);"
    puts $fp "  font-weight: 400;"
    puts $fp "  letter-spacing: -0.022em;"
    puts $fp "}"
    puts $fp ".eyebrow {"
    puts $fp "  font-family: var(--font-mono);"
    puts $fp "  font-size: 0.75rem;"
    puts $fp "  letter-spacing: 0.16em;"
    puts $fp "  text-transform: uppercase;"
    puts $fp "}"
    puts $fp ".focus-ring:focus-visible {"
    puts $fp "  outline: 2px solid var(--accent);"
    puts $fp "  outline-offset: 4px;"
    puts $fp "}"
    puts $fp ".content-auto { content-visibility: auto; contain-intrinsic-size: 1px 800px; }"
    puts $fp ""
    puts $fp "@media (prefers-reduced-motion: reduce) {"
    puts $fp "  html { scroll-behavior: auto; }"
    puts $fp "  *, *::before, *::after {"
    puts $fp "    animation-duration: 0.01ms !important;"
    puts $fp "    animation-iteration-count: 1 !important;"
    puts $fp "    scroll-behavior: auto !important;"
    puts $fp "    transition-duration: 0.01ms !important;"
    puts $fp "  }"
    puts $fp "}"
    puts $fp ""
    puts $fp "/* Header ausblenden solange PondExperience aktiv ist (data-hero-immersive) */"
    puts $fp "body[data-hero-immersive=\"true\"] > header,"
    puts $fp "body[data-hero-immersive=\"true\"] header[data-site-header] {"
    puts $fp "  opacity: 0;"
    puts $fp "  pointer-events: none;"
    puts $fp "  transition: opacity 0.4s ease-out;"
    puts $fp "}"
    puts $fp ""
    puts $fp "/* Wassertropfen die frontal am Screen herunterlaufen (Splash-Overlay) */"
    puts $fp "@keyframes dropfall {"
    puts $fp "  0% {"
    puts $fp "    transform: translateY(0);"
    puts $fp "    opacity: 0;"
    puts $fp "  }"
    puts $fp "  10% {"
    puts $fp "    opacity: 0.9;"
    puts $fp "  }"
    puts $fp "  90% {"
    puts $fp "    opacity: 0.7;"
    puts $fp "  }"
    puts $fp "  100% {"
    puts $fp "    transform: translateY(110vh);"
    puts $fp "    opacity: 0;"
    puts $fp "  }"
    puts $fp "}"
    
    close $fp
}

# Hauptprogramm
if {$argc != 1} {
    puts stderr "Verwendung: [info script] <ausgabedatei>"
    exit 1
}

set outputFile [lindex $argv 0]
writeGlobalsCss $outputFile
