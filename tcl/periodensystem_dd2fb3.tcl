    append html "  color: var(--text);\n"
    append html "  padding: 24px;\n"
    append html "  max-width: 1100px;\n"
    append html "  margin: 0 auto;\n"
    append html "  line-height: 1.5;\n"
    append html "}\n"
    append html "h1 { font-size: 22px; font-weight: 500; margin-bottom: 4px; }\n"
    append html ".subtitle { color: var(--text-muted); font-size: 14px; margin-bottom: 20px; }\n"
    append html ".detail {\n"
    append html "  background: var(--surface);\n"
    append html "  border: 1px solid var(--border);\n"
    append html "  border-radius: 12px;\n"
    append html "  padding: 16px 20px;\n"
    append html "  min-height: 110px;\n"
    append html "  display: flex;\n"
    append html "  align-items: center;\n"
    append html "  gap: 20px;\n"
    append html "  margin-bottom: 16px;\n"
    append html "}\n"
    append html ".detail-empty {\n"
    append html "  color: var(--text-muted);\n"
    append html "  font-size: 14px;\n"
    append html "  text-align: center;\n"
    append html "  width: 100%;\n"
    append html "}\n"
    append html ".symbol-box {\n"
    append html "  font-size: 40px;\n"
    append html "  font-weight: 500;\n"
    append html "  line-height: 1;\n"
    append html "  width: 80px;\n"
    append html "  height: 80px;\n"
    append html "  display: flex;\n"
    append html "  align-items: center;\n"
    append html "  justify-content: center;\n"
    append html "  border-radius: 8px;\n"
    append html "  flex-shrink: 0;\n"
    append html "}\n"
    append html ".info-name { font-size: 20px; font-weight: 500; margin-bottom: 8px; }\n"
    append html ".info-meta {\n"
    append html "  font-size: 13px;\n"
    append html "  color: var(--text-muted);\n"
    append html "  display: grid;\n"
    append html "  grid-template-columns: repeat(2, minmax(0, 1fr));\n"
    append html "  gap: 4px 24px;\n"
    append html "}\n"
    append html ".info-meta b { font-weight: 500; color: var(--text); margin-left: 6px; }\n"
    append html ".grid {\n"
    append html "  display: grid;\n"
    append html "  grid-template-columns: repeat(18, minmax(0, 1fr));\n"
    append html "  gap: 3px;\n"
    append html "}\n"
    append html ".fgrid { margin-top: 8px; }\n"
    append html ".cell {\n"
    append html "  aspect-ratio: 1;\n"
    append html "  border-radius: 4px;\n"
    append html "  padding: 3px;\n"
    append html "  display: flex;\n"
    append html "  flex-direction: column;\n"
    append html "  align-items: center;\n"
    append html "  justify-content: center;\n"
    append html "  cursor: pointer;\n"
    append html "  font-family: inherit;\n"
    append html "  line-height: 1;\n"
    append html "  transition: transform 0.12s ease;\n"
    append html "  border: 0;\n"
    append html "  position: relative;\n"
    append html "  overflow: hidden;\n"
    append html "}\n"
    append html ".cell:hover { transform: scale(1.18); z-index: 5; box-shadow: 0 2px 8px rgba(0,0,0,0.15); }\n"
    append html ".cell:focus-visible { outline: 2px solid var(--text); outline-offset: 1px; }\n"
    append html ".cell.active { outline: 2px solid var(--text); outline-offset: 1px; z-index: 4; }\n"
    append html ".cell .num { font-size: 9px; opacity: 0.75; align-self: flex-start; line-height: 1; padding-left: 2px; }\n"
    append html ".cell .sym { font-size: 14px; font-weight: 500; margin-top: 2px; }\n"
    append html ".cell-marker {\n"
    append html "  cursor: default;\n"
    append html "  font-size: 9px;\n"
    append html "  font-weight: 500;\n"
    append html "  border: 1px dashed currentColor;\n"
    append html "  background: transparent !important;\n"
    append html "}\n"
    append html ".cell-marker:hover { transform: none; box-shadow: none; }\n"
    append html ".cat-am { background: #FCEBEB; color: #501313; }\n"
    append html ".cat-em { background: #FAEEDA; color: #412402; }\n"
    append html ".cat-tm { background: #E6F1FB; color: #042C53; }\n"
    append html ".cat-ptm { background: #F1EFE8; color: #2C2C2A; }\n"
    append html ".cat-hm { background: #E1F5EE; color: #04342C; }\n"
    append html ".cat-nm { background: #EAF3DE; color: #173404; }\n"
    append html ".cat-h { background: #EEEDFE; color: #26215C; }\n"
    append html ".cat-eg { background: #FBEAF0; color: #4B1528; }\n"
    append html ".cat-la { background: #FAECE7; color: #4A1B0C; }\n"
    append html ".cat-ac { background: #F5C4B3; color: #4A1B0C; }\n"
    append html "@media (prefers-color-scheme: dark) {\n"
    append html "  .cat-am { background: #791F1F; color: #F7C1C1; }\n"
    append html "  .cat-em { background: #633806; color: #FAC775; }\n"
    append html "  .cat-tm { background: #0C447C; color: #B5D4F4; }\n"
    append html "  .cat-ptm { background: #444441; color: #D3D1C7; }\n"
    append html "  .cat-hm { background: #085041; color: #9FE1CB; }\n"
    append html "  .cat-nm { background: #27500A; color: #C0DD97; }\n"
    append html "  .cat-h { background: #3C3489; color: #CECBF6; }\n"
    append html "  .cat-eg { background: #72243E; color: #F4C0D1; }\n"
    append html "  .cat-la { background: #712B13; color: #F5C4B3; }\n"
    append html "  .cat-ac { background: #993C1D; color: #F5C4B3; }\n"
    append html "}\n"
    append html ".legend {\n"
    append html "  display: grid;\n"
    append html "  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\n"
    append html "  gap: 8px 16px;\n"
    append html "  margin-top: 24px;\n"
    append html "  font-size: 12px;\n"
    append html "  color: var(--text-muted);\n"
    append html "}\n"
    append html ".legend-item { display: flex; align-items: center; gap: 8px; }\n"
    append html ".legend-swatch { width: 14px; height: 14px; border-radius: 3px; flex-shrink: 0; }\n"
    append html "</style>\n"
    append html "</head>\n"
    append html "<body>\n"
    append html "<h1>Periodensystem der Elemente</h1>\n"
    append html "<p class=\"subtitle\">Klicke auf ein Element, um Details zu sehen.</p>\n"
    append html "<div class=\"detail\" id=\"detail\"><div class=\"detail-empty\">Klicke auf ein Element, um Details zu sehen</div></div>\n"
    append html "<div class=\"grid\" id=\"main\"></div>\n"
    append html "<div class=\"grid fgrid\" id=\"fblock\"></div>\n"
    append html "<div class=\"legend\" id=\"legend\"></div>\n"
    append html "<script>\n"
    
    # JavaScript data and functions
    append html "const E = [\n"
    append html "  \[1,'H','Wasserstoff','1,008','nm',1,1\],\[2,'He','Helium','4,003','eg',1,18\],\n"
    append html "  \[3,'Li','Lithium','6,94','am',2,1\],\[4,'Be','Beryllium','9,012','em',2,2\],\n"
    append html "  \[5,'B','Bor','10,81','hm',2,13\],\[6,'C','Kohlenstoff','12,011','nm',2,14\],\n"
    append html "  \[7,'N','Stickstoff','14,007','nm',2,15\],\[8,'O','Sauerstoff','15,999','nm',2,16\],\n"
    append html "  \[9,'F','Fluor','18,998','h',2,17\],\[10,'Ne','Neon','20,180','eg',2,18\],\n"
    append html "  \[11,'Na','Natrium','22,990','am',3,1\],\[12,'Mg','Magnesium','24,305','em',3,2\],\n"
    append html "  \[13,'Al','Aluminium','26,982','ptm',3,13\],\[14,'Si','Silicium','28,085','hm',3,14\],\n"
    append html "  \[15,'P','Phosphor','30,974','nm',3,15\],\[16,'S','Schwefel','32,06','nm',3,16\],\n"
    append html "  \[17,'Cl','Chlor','35,45','h',3,17\],\[18,'Ar','Argon','39,948','eg',3,18\],\n"
    append html "  \[19,'K','Kalium','39,098','am',4,1\],\[20,'Ca','Calcium','40,078','em',4,2\],\n"
    append html "  \[21,'Sc','Scandium','44,956','tm',4,3\],\[22,'Ti','Titan','47,867','tm',4,4\],\n"
    append html "  \[23,'V','Vanadium','50,942','tm',4,5\],\[24,'Cr','Chrom','51,996','tm',4,6\],\n"
    append html "  \[25,'Mn','Mangan','54,938','tm',4,7\],\[26,'Fe','Eisen','55,845','tm',4,8\],\n"
    append html "  \[27,'Co','Cobalt','58,933','tm',4,9\],\[28,'Ni','Nickel','58,693','tm',4,10\],\n"
    append html "  \[29,'Cu','Kupfer','63,546','tm',4,11\],\[30,'Zn','Zink','65,38','tm',4,12\],\n"
    append html "  \[31,'Ga','Gallium','69,723','ptm',4,13\],\[32,'Ge','Germanium','72,630','hm',4,14\],\n"
    append html "  \[33,'As','Arsen','74,922','hm',4,15\],\[34,'Se','Selen','78,971','nm',4,16\],\n"
    append html "  \[35,'Br','Brom','79,904','h',4,17\],\[36,'Kr','Krypton','83,798','eg',4,18\],\n"
    append html "  \[37,'Rb','Rubidium','85,468','am',5,1\],\[38,'Sr','Strontium','87,62','em',5,2\],\n"
    append html "  \[39,'Y','Yttrium','88,906','tm',5,3\],\[40,'Zr','Zirconium','91,224','tm',5,4\],\n"
    append html "  \[41,'Nb','Niob','92,906','tm',5,5\],\[42,'Mo','Molybdän','95,95','tm',5,6\],\n"
    append html "  \[43,'Tc','Technetium','98','tm',5,7\],\[44,'Ru','Ruthenium','101,07','tm',5,8\],\n"
    append html "  \[45,'Rh','Rhodium','102,906','tm',5,9\],\[46,'Pd','Palladium','106,42','tm',5,10\],\n"
    append html "  \[47,'Ag','Silber','107,868','tm',5,11\],\[48,'Cd','Cadmium','112,414','tm',5,12\],\n"
    append html "  \[49,'In','Indium','114,818','ptm',5,13\],\[50,'Sn','Zinn','118,710','ptm',5,14\],\n"
    append html "  \[51,'Sb','Antimon','121,760','hm',5,15\],\[52,'Te','Tellur','127,60','hm',5,16\],\n"
    append html "  \[53,'I','Iod','126,904','h',5,17\],\[54,'Xe','Xenon','131,293','eg',5,18\],\n"
    append html "  \[55,'Cs','Caesium','132,905','am',6,1\],\[56,'Ba','Barium','137,327','em',6,2\],\n"
    append html "  \[57,'La','Lanthan','138,905','la',8,3\],\[58,'Ce','Cer','140,116','la',8,4\],\n"
    append html "  \[59,'Pr','Praseodym','140,908','la',8,5\],\[60,'Nd','Neodym','144,242','la',8,6\],\n"
    append html "  \[61,'Pm','Promethium','145','la',8,7\],\[62,'Sm','Samarium','150,36','la',8,8\],\n"
    append html "  \[63,'Eu','Europium','151,964','la',8,9\],\[64,'Gd','Gadolinium','157,25','la',8,10\],\n"
    append html "  \[65,'Tb','Terbium','158,925','la',8,11\],\[66,'Dy','Dysprosium','162,500','la',8,12\],\n"
    append html "  \[67,'Ho','Holmium','164,930','la',8,13\],\[68,'Er','Erbium','167,259','la',8,14\],\n"
    append html "  \[69,'Tm','Thulium','168,934','la',8,15\],\[70,'Yb','Ytterbium','173,045','la',8,16\],\n"
    append html "  \[71,'Lu','Lutetium','174,967','la',8,17\],\n"
    append html "  \[72,'Hf','Hafnium','178,486','tm',6,4\],\[73,'Ta','Tantal','180,948','tm',6,5\],\n"
    append html "  \[74,'W','Wolfram','183,84','tm',6,6\],\[75,'Re','Rhenium','186,207','tm',6,7\],\n"
    append html "  \[76,'Os','Osmium','190,23','tm',6,8\],\[77,'Ir','Iridium','192,217','tm',6,9\],\n"
    append html "  \[78,'Pt','Platin','195,084','tm',6,10\],\[79,'Au','Gold','196,967','tm',6,11\],\n"
    append html "  \[80,'Hg','Quecksilber','200,592','tm',6,12\],\[81,'Tl','Thallium','204,38','ptm',6,13\],\n"
    append html "  \[82,'Pb','Blei','207,2','ptm',6,14\],\[83,'Bi','Bismut','208,980','ptm',6,15\],\n"
    append html "  \[84,'Po','Polonium','209','ptm',6,16\],\[85,'At','Astat','210','h',6,17\],\n"
    append html "  \[86,'Rn','Radon','222','eg',6,18\],\n"
    append html "  \[87,'Fr','Francium','223','am',7,1\],\[88,'Ra','Radium','226','em',7,2\],\n"
    append html "  \[89,'Ac','Actinium','227','ac',9,3\],\[90,'Th','Thorium','232,038','ac',9,4\],\n"
    append html "  \[91,'Pa','Protactinium','231,036','ac',9,5\],\[92,'U','Uran','238,029','ac',9,6\],\n"
    append html "  \[93,'Np','Neptunium','237','ac',9,7\],\[94,'Pu','Plutonium','244','ac',9,8\],\n"
    append html "  \[95,'Am','Americium','243','ac',9,9\],\[96,'Cm','Curium','247','ac',9,10\],\n"
    append html "  \[97,'Bk','Berkelium','247','ac',9,11\],\[98,'Cf','Californium','251','ac',9,12\],\n"
    append html "  \[99,'Es','Einsteinium','252','ac',9,13\],\[100,'Fm','Fermium','257','ac',9,14\],\n"
    append html "  \[101,'Md','Mendelevium','258','ac',9,15\],\[102,'No','Nobelium','259','ac',9,16\],\n"
    append html "  \[103,'Lr','Lawrencium','266','ac',9,17\],\n"
    append html "  \[104,'Rf','Rutherfordium','267','tm',7,4\],\[105,'Db','Dubnium','268','tm',7,5\],\n"
    append html "  \[106,'Sg','Seaborgium','269','tm',7,6\],\[107,'Bh','Bohrium','270','tm',7,7\],\n"
    append html "  \[108,'Hs','Hassium','270','tm',7,8\],\[109,'Mt','Meitnerium','278','tm',7,9\],\n"
    append html "  \[110,'Ds','Darmstadtium','281','tm',7,10\],\[111,'Rg','Roentgenium','282','tm',7,11\],\n"
    append html "  \[112,'Cn','Copernicium','285','tm',7,12\],\[113,'Nh','Nihonium','286','ptm',7,13\],\n"
    append html "  \[114,'Fl','Flerovium','289','ptm',7,14\],\[115,'Mc','Moscovium','289','ptm',7,15\],\n"
    append html "  \[116,'Lv','Livermorium','293','ptm',7,16\],\[117,'Ts','Tenness','294','h',7,17\],\n"
    append html "  \[118,'Og','Oganesson','294','eg',7,18\]\n"
    append html "];\n"
    append html "const CAT = {\n"
    append html "  am:'Alkalimetall', em:'Erdalkalimetall', tm:'Übergangsmetall',\n"
    append html "  ptm:'Metall (Hauptgr.)', hm:'Halbmetall', nm:'Nichtmetall',\n"
    append html "  h:'Halogen', eg:'Edelgas', la:'Lanthanoid', ac:'Actinoid'\n"
    append html "};\n"
    append html "const CATPL = {\n"
    append html "  am:'Alkalimetalle', em:'Erdalkalimetalle', tm:'Übergangsmetalle',\n"
    append html "  ptm:'Metalle (Hauptgr.)', hm:'Halbmetalle', nm:'Nichtmetalle',\n"
    append html "  h:'Halogene', eg:'Edelgase', la:'Lanthanoide', ac:'Actinoide'\n"
    append html "};\n"
    append html "function showDetail(el) {\n"
    append html "  const \[z, sym, name, mass, cat, row, col\] = el;\n"
    append html "  const period = row >= 8 ? (row === 8 ? 6 : 7) : row;\n"
    append html "  const group = row >= 8 ? 'f-Block' : col;\n"
    append html "  document.getElementById('detail').innerHTML = `\n"
    append html "    <div class=\"symbol-box cat-\${cat}\">\${sym}</div>\n"
    append html "    <div style=\"flex:1;min-width:0\">\n"
    append html "      <div class=\"info-name\">\${name}</div>\n"
    append html "      <div class=\"info-meta\">\n"
    append html "        <span>Ordnungszahl:<b>\${z}</b></span>\n"
    append html "        <span>Atommasse:<b>\${mass} u</b></span>\n"
    append html "        <span>Periode:<b>\${period}</b></span>\n"
    append html "        <span>Gruppe:<b>\${group}</b></span>\n"
    append html "        <span style=\"grid-column:1/-1\">Kategorie:<b>\${CAT\[cat\]}</b></span>\n"
    append html "      </div>\n"
    append html "    </div>`;\n"
    append html "  document.querySelectorAll('.cell.active').forEach(c => c.classList.remove('active'));\n"
    append html "  const cell = document.querySelector(\`[data-z=\"\${z}\"]\`);\n"
    append html "  if (cell) cell.classList.add('active');\n"
    append html "}\n"
    append html "function makeCell(el) {\n"
    append html "  const \[z, sym, name, mass, cat, row, col\] = el;\n"
    append html "  const c = document.createElement('button');\n"
    append html "  c.className = \`cell cat-\${cat}\`;\n"
    append html "  c.style.gridColumn = col;\n"
    append html "  c.style.gridRow = row >= 8 ? row - 7 : row;\n"
    append html "  c.dataset.z = z;\n"
    append html "  c.title = `\${name} (\${sym})`;\n"
    append html "  c.innerHTML = \`<span class=\"num\">\${z}</span><span class=\"sym\">\${sym}</span>\`;\n"
    append html "  c.onclick = () => showDetail(el);\n"
    append html "  return c;\n"
    append html "}\n"
    append html "const main = document.getElementById('main');\n"
    append html "const fblock = document.getElementById('fblock');\n"
    append html "\[\[6, 'la', '57-71'\], \[7, 'ac', '89-103'\]\].forEach((\[r, cat, txt\]) => {\n"
    append html "  const m = document.createElement('div');\n"
    append html "  m.className = \`cell cell-marker cat-\${cat}\`;\n"
    append html "  m.style.gridColumn = 3;\n"
    append html "  m.style.gridRow = r;\n"
    append html "  m.textContent = txt;\n"
    append html "  main.appendChild(m);\n"
    append html "});\n"
    append html "E.forEach(el => {\n"
    append html "  const c = makeCell(el);\n"
    append html "  if (el\[5\] >= 8) fblock.appendChild(c);\n"
    append html "  else main.appendChild(c);\n"
    append html "});\n"
    append html "const legend = document.getElementById('legend');\n"
    append html "Object.entries(CATPL).forEach((\[k, v\]) => {\n"
    append html "  const item = document.createElement('div');\n"
    append html "  item.className = 'legend-item';\n"
    append html "  item.innerHTML = \`<span class=\"legend-swatch cat-\${k}\"></span><span>\${v}</span>\`;\n"
    append html "  legend.appendChild(item);\n"
    append html "});\n"
    append html "</script>\n"
    append html "</body>\n"
    append html "</html>\n"
    
    # Write to file
    set fh [open $filename w]
    puts $fh $html
    close $fh
}

# Main execution
if {$argc != 1} {
    puts "Usage: $argv0 <output-file>"
    exit 1
}

set output_file [lindex $argv 0]
generate_periodic_table $output_file
puts "Generated $output_file"
