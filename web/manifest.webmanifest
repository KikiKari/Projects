{
  "id": "/",
  "name": "Telegram Monitor Companion",
  "short_name": "Monitor",
  "description": "Beobachtet öffentliche Telegram-Kanäle und TikTok-Konten, meldet den Livegang und zeigt Status und Verlauf.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#2481cc",
  "lang": "de",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "/icons/monitor-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/monitor-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/monitor-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Live-Verlauf", "url": "/#live" },
    { "name": "TikTok-Status", "url": "/#tiktok" },
    { "name": "Beobachtungsliste", "url": "/#watchlist" }
  ]
}
